# Production env template. Customer fills these per deployment.
# DO NOT COMMIT a real prod.env — these are secrets.

EHR_TOKEN_URL=https://<customer-epic-auth-endpoint>/oauth/token
EHR_CLIENT_ID=<customer-issued-client-id>
EHR_CLIENT_SECRET=<set-via-secret-manager-NOT-here>
SERVICE_PRINCIPAL=triage-assistant@<customer-cloud-project>

# Audit sink (prod swap path)
AUDIT_SINK_TYPE=cloud_logging
AUDIT_SINK_PROJECT=<customer-gcp-or-azure-or-aws-project>
